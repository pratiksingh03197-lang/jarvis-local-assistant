# Copy this file to .env and add only keys you personally created.
# The real .env file is ignored by Git. Never share it or paste it into chat.

# Optional: enables JARVIS online mode with Gemini speech recognition and chat.
# Create a key in Google AI Studio, then replace the placeholder below.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq is used for chat and speech when this key is present.
GROQ_API_KEY=your_groq_api_key_here

# Optional: enables confirmed SerpApi web-result summaries.
SERPAPI_KEY=your_serpapi_key_here

